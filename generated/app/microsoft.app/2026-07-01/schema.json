{
  "id": "https://schema.management.azure.com/schemas/2026-07-01/Microsoft.App.json#",
  "title": "Microsoft.App",
  "description": "Microsoft App Resource Types",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "resourceDefinitions": {
    "agents": {
      "description": "Microsoft.App/agents",
      "properties": {
        "apiVersion": {
          "enum": [
            "2026-07-01"
          ],
          "type": "string"
        },
        "identity": {
          "description": "The managed service identities assigned to this resource.",
          "oneOf": [
            {
              "$ref": "#/definitions/ManagedServiceIdentity"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "location": {
          "description": "The geo-location where the resource lives",
          "type": "string"
        },
        "name": {
          "description": "The name of the Agent",
          "oneOf": [
            {
              "pattern": "^[A-Za-z]([-A-Za-z0-9]{0,30}[A-Za-z0-9])$",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "properties": {
          "description": "The resource-specific properties for this resource.",
          "oneOf": [
            {
              "$ref": "#/definitions/AgentProperties"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "resources": {
          "items": {
            "oneOf": [
              {
                "$ref": "#/definitions/agents_connectors_childResource"
              }
            ]
          },
          "type": "array"
        },
        "tags": {
          "description": "Resource tags.",
          "oneOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "properties": {},
              "type": "object"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "type": {
          "enum": [
            "Microsoft.App/agents"
          ],
          "type": "string"
        }
      },
      "required": [
        "name",
        "properties",
        "apiVersion",
        "type"
      ],
      "type": "object"
    },
    "agents_connectors": {
      "description": "Microsoft.App/agents/connectors",
      "properties": {
        "apiVersion": {
          "enum": [
            "2026-07-01"
          ],
          "type": "string"
        },
        "name": {
          "description": "The name of the AgentConnector",
          "oneOf": [
            {
              "pattern": "^[A-Za-z]([-A-Za-z0-9]{0,30}[A-Za-z0-9])$",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "properties": {
          "description": "The resource-specific properties for this resource.",
          "oneOf": [
            {
              "$ref": "#/definitions/AgentConnectorProperties"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "type": {
          "enum": [
            "Microsoft.App/agents/connectors"
          ],
          "type": "string"
        }
      },
      "required": [
        "name",
        "properties",
        "apiVersion",
        "type"
      ],
      "type": "object"
    }
  },
  "definitions": {
    "ActionConfiguration": {
      "description": "Configuration for action",
      "properties": {
        "accessLevel": {
          "description": "The access level of the action",
          "oneOf": [
            {
              "enum": [
                "Low",
                "High"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "identity": {
          "description": "The identity used by the action",
          "type": "string"
        },
        "mode": {
          "description": "The mode of the action",
          "oneOf": [
            {
              "enum": [
                "Autonomous",
                "Review",
                "ReadOnly"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    },
    "AgentConnectorProperties": {
      "description": "Agent Connector Properties",
      "properties": {
        "dataConnectorType": {
          "description": "The type of the data connector",
          "type": "string"
        },
        "dataSource": {
          "description": "Data source connection string or endpoint supplied when creating or updating a connector.",
          "type": "string"
        },
        "endpoint": {
          "description": "Endpoint of the connector",
          "type": "string"
        },
        "extendedProperties": {
          "description": "Additional properties for the data connector which can be used to store custom key-value pairs",
          "oneOf": [
            {
              "additionalProperties": {},
              "properties": {},
              "type": "object"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "identity": {
          "description": "Identity used to access the data source",
          "type": "string"
        }
      },
      "type": "object"
    },
    "AgentIdentity": {
      "description": "Agent identity configuration",
      "properties": {
        "initialSponsorGroupId": {
          "description": "Initial sponsor group ID (required for agent identity)",
          "type": "string"
        }
      },
      "required": [
        "initialSponsorGroupId"
      ],
      "type": "object"
    },
    "AgentProperties": {
      "description": "Properties of the Agent",
      "properties": {
        "actionConfiguration": {
          "description": "Configuration for action",
          "oneOf": [
            {
              "$ref": "#/definitions/ActionConfiguration"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "agentIdentity": {
          "description": "Agent identity configuration for accessing resources",
          "oneOf": [
            {
              "$ref": "#/definitions/AgentIdentity"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "defaultModel": {
          "description": "Default AI model configuration for the agent",
          "oneOf": [
            {
              "$ref": "#/definitions/DefaultModel"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "incidentManagementConfiguration": {
          "description": "Incident management configurations",
          "oneOf": [
            {
              "$ref": "#/definitions/IncidentManagementConfiguration"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "knowledgeGraphConfiguration": {
          "description": "Knowledge graph configuration for agent",
          "oneOf": [
            {
              "$ref": "#/definitions/KnowledgeGraphConfiguration"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "logConfiguration": {
          "description": "Log configurations",
          "oneOf": [
            {
              "$ref": "#/definitions/LogConfiguration"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "sandboxConfiguration": {
          "description": "Desired sandbox configuration. PUT represents the complete desired configuration and does not preserve an existing\nvalue when this property is omitted.\nUse PATCH to preserve the stored configuration while updating other properties.",
          "oneOf": [
            {
              "$ref": "#/definitions/SandboxConfiguration"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "upgradeChannel": {
          "description": "The upgrade channel of the agent",
          "oneOf": [
            {
              "enum": [
                "Preview",
                "Stable"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "vnetConfiguration": {
          "description": "Desired virtual network configuration. A subnet and AzureVNet egress mode must be configured together.\nUse PATCH for selective updates. Omitting networking settings from PUT can clear them or fail validation.",
          "oneOf": [
            {
              "$ref": "#/definitions/VnetConfiguration"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    },
    "ApplicationInsightsConfiguration": {
      "description": "Application Insights Configuration",
      "properties": {
        "appId": {
          "description": "The Application ID for the Application Insights resource",
          "type": "string"
        },
        "connectionString": {
          "description": "The connection string supplied when creating or updating the Application Insights configuration.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "DefaultModel": {
      "description": "Default AI model configuration",
      "properties": {
        "name": {
          "description": "Model name (e.g., gpt-5, claude-opus-4-5, claude-sonnet-4-5)",
          "type": "string"
        },
        "provider": {
          "description": "AI provider name (e.g., MicrosoftFoundry, Anthropic)",
          "type": "string"
        }
      },
      "type": "object"
    },
    "IncidentManagementConfiguration": {
      "description": "Incident Management Configurations",
      "properties": {
        "connectionKey": {
          "description": "The key supplied when creating or updating the connection.",
          "type": "string"
        },
        "connectionName": {
          "description": "The name of the connection",
          "type": "string"
        },
        "connectionUrl": {
          "description": "The URL of the connection",
          "type": "string"
        },
        "oboUser": {
          "description": "The user for the connection",
          "type": "string"
        },
        "type": {
          "description": "The type of incident management system",
          "type": "string"
        }
      },
      "type": "object"
    },
    "KnowledgeGraphConfiguration": {
      "description": "Knowledge graph configuration for agent",
      "properties": {
        "identity": {
          "description": "The identity used to access the knowledge graph",
          "type": "string"
        },
        "managedResources": {
          "description": "The list of resources managed by agent",
          "oneOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    },
    "LogConfiguration": {
      "description": "Log Configurations",
      "properties": {
        "applicationInsightsConfiguration": {
          "description": "Application Insights Configuration",
          "oneOf": [
            {
              "$ref": "#/definitions/ApplicationInsightsConfiguration"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    },
    "ManagedServiceIdentity": {
      "description": "Managed service identity (system assigned and/or user assigned identities)",
      "properties": {
        "type": {
          "description": "Type of managed service identity (where both SystemAssigned and UserAssigned types are allowed).",
          "oneOf": [
            {
              "enum": [
                "None",
                "SystemAssigned",
                "UserAssigned",
                "SystemAssigned,UserAssigned"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "userAssignedIdentities": {
          "description": "The set of user assigned identities associated with the resource. The userAssignedIdentities dictionary keys will be ARM resource ids in the form: '/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.ManagedIdentity/userAssignedIdentities/{identityName}. The dictionary values can be empty objects ({}) in requests.",
          "oneOf": [
            {
              "additionalProperties": {
                "$ref": "#/definitions/UserAssignedIdentity"
              },
              "properties": {},
              "type": "object"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "SandboxConfiguration": {
      "description": "Desired configuration for the agent's sandbox.",
      "properties": {
        "egress": {
          "description": "Sandbox egress configuration. In PATCH, omission preserves egress and JSON merge-patch null clears it.\nClearing egress is invalid while a subnet remains configured.",
          "oneOf": [
            {
              "$ref": "#/definitions/SandboxEgressConfiguration"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "packages": {
          "description": "Packages to preinstall in the sandbox. In PATCH, omission preserves the package list.\nA supplied array replaces the entire list; JSON merge-patch null clears it. An empty array selects no packages.\nEach supplied package must include its name and package manager.",
          "oneOf": [
            {
              "items": {
                "$ref": "#/definitions/SandboxPackageSpec"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    },
    "SandboxEgressConfiguration": {
      "description": "Desired outbound network configuration for the agent's sandbox.",
      "properties": {
        "allowHttpMcpServerNetworkAccess": {
          "description": "Whether remote HTTP MCP servers can use the managed network path.\nIn PATCH, omission preserves the setting and JSON merge-patch null clears it.",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "allowedCodeRepositories": {
          "description": "Code repository provider identifiers allowed on the managed network path. Values are matched case-sensitively.\nKnown values are 'Github', 'GithubEnterprise', 'AzureDevOps' and 'GitLab'. The service validates the values.\nIn PATCH, omission preserves the list, a supplied array replaces it, and JSON merge-patch null clears it.",
          "oneOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "allowedHosts": {
          "description": "Additional hostnames allowed on the managed network path.\nEntries are DNS hostnames or leading wildcard patterns such as '*.example.com'; a bare '*' is invalid.\nEach entry has at most 253 characters and each DNS label at most 63 characters.\nWildcard patterns must contain at least two labels after '*.'.\nIn PATCH, omission preserves the list, a supplied array replaces it, and JSON merge-patch null clears it.",
          "oneOf": [
            {
              "items": {
                "maxLength": 253,
                "minLength": 1,
                "pattern": "^(\\*\\.(?=[^.]+\\.))?[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "allowedRegistries": {
          "description": "Package registry identifiers allowed on the managed network path. Values are matched without regard to case.\nKnown values are 'pypi', 'npmjs', 'nuget-org' and 'ubuntu'. The service validates the values.\nIn PATCH, omission preserves the list, a supplied array replaces it, and JSON merge-patch null clears it.",
          "oneOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "httpProxy": {
          "description": "Forward-proxy configuration for sandbox outbound requests.\nUsed only when forward-proxy support is enabled for the Agent and the egress mode is AzureVNet.\nSupplying this configuration does not enable forward-proxy support.\nIn PATCH, omission preserves the configuration, JSON merge-patch null clears it, and a supplied object merges its members.\nThe resulting proxy configuration must include httpsUrl.",
          "oneOf": [
            {
              "$ref": "#/definitions/SandboxHttpProxyConfiguration"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "mode": {
          "description": "Sandbox egress mode. AzureVNet requires a subnet, and a configured subnet requires AzureVNet.\nIn PATCH, omission preserves the mode and JSON merge-patch null clears it.\nClearing the mode is invalid while a subnet remains configured.\nNo unconditional default applies.",
          "oneOf": [
            {
              "enum": [
                "Unrestricted",
                "Limited",
                "AzureVNet"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    },
    "SandboxHttpProxyConfiguration": {
      "description": "Forward-proxy endpoints and additional destinations that bypass the proxy.",
      "properties": {
        "httpUrl": {
          "description": "Optional proxy endpoint used for HTTP destinations. When set, it must be the same proxy origin as httpsUrl;\ndifferent HTTP and HTTPS proxies are not supported.\nThe value must be an absolute http:// origin with a host. Credentials, paths other than '/', query strings,\nfragments, and ports 0, 80, and 443 are not supported.\nIn PATCH, omission preserves the endpoint and JSON merge-patch null clears it.",
          "type": "string"
        },
        "httpsUrl": {
          "description": "Proxy endpoint used for HTTPS destinations and CONNECT tunneling. Required whenever a proxy configuration is stored.\nThe proxy URL itself must use http:// for CONNECT tunneling and must be an origin with a host.\nCredentials, paths other than '/', query strings, fragments, and ports 0, 80, and 443 are not supported.\nIn PATCH, omission preserves the endpoint.",
          "type": "string"
        },
        "noProxy": {
          "description": "Additional destinations that bypass the forward proxy.\nEntries can be DNS hostnames, leading-dot or '*.' suffix patterns, or exact IPv4 addresses.\nCIDR blocks, IPv6 addresses, ports, empty entries, and a bare '*' are invalid.\nIn PATCH, omission preserves the list, a supplied array replaces it, and JSON merge-patch null clears it.",
          "oneOf": [
            {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    },
    "SandboxPackageSpec": {
      "description": "A package to preinstall in the sandbox. Package arrays are replaced as a whole.",
      "properties": {
        "name": {
          "description": "Package name, optionally including a scope or namespace prefix.",
          "oneOf": [
            {
              "maxLength": 214,
              "minLength": 1,
              "pattern": "^@?[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)?$",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "packageManager": {
          "description": "Package manager used to install the package. Values are case-sensitive.",
          "oneOf": [
            {
              "enum": [
                "pip",
                "npm",
                "nuget"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "version": {
          "description": "Optional package version or version constraint. Omit it to leave the version unspecified.",
          "oneOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._+\\-~^<>=,*\\[\\]()]+$",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "required": [
        "name",
        "packageManager"
      ],
      "type": "object"
    },
    "UserAssignedIdentity": {
      "description": "User assigned identity properties",
      "properties": {},
      "type": "object"
    },
    "VnetConfiguration": {
      "description": "Desired subnet configuration for the agent's sandbox.",
      "properties": {
        "subnetResourceId": {
          "description": "Azure resource ID of the subnet used with AzureVNet egress mode.\nIn PATCH, omission preserves the subnet and JSON merge-patch null clears it.\nSetting or replacing a subnet requires the resulting egress mode to be AzureVNet.\nWhen clearing the subnet, also update sandbox egress in the same PATCH request so the resulting mode is not AzureVNet.\nThe detach example explicitly selects Limited.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "agents_connectors_childResource": {
      "description": "Microsoft.App/agents/connectors",
      "properties": {
        "apiVersion": {
          "enum": [
            "2026-07-01"
          ],
          "type": "string"
        },
        "name": {
          "description": "The name of the AgentConnector",
          "oneOf": [
            {
              "pattern": "^[A-Za-z]([-A-Za-z0-9]{0,30}[A-Za-z0-9])$",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "properties": {
          "description": "The resource-specific properties for this resource.",
          "oneOf": [
            {
              "$ref": "#/definitions/AgentConnectorProperties"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "type": {
          "enum": [
            "connectors"
          ],
          "type": "string"
        }
      },
      "required": [
        "name",
        "properties",
        "apiVersion",
        "type"
      ],
      "type": "object"
    }
  }
}