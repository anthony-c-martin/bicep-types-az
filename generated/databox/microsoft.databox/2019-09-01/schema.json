          ]
        },
        "totalFilesToProcess": {
          "description": "Total number of files to be processed by the job.",
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
