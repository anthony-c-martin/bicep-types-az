            {
              "enum": [
                "NotStarted",
                "InProgress",
                "Completed",
                "CompletedWithErrors",
                "Failed",
                "NotReturned",
                "HardwareError",
                "DeviceFormatted",
                "DeviceMetadataModified",
                "StorageAccountNotAccessible",
                "UnsupportedData"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
