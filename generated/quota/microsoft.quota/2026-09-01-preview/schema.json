{
  "id": "https://schema.management.azure.com/schemas/2026-09-01-preview/Microsoft.Quota.json#",
  "title": "Microsoft.Quota",
  "description": "Microsoft Quota Resource Types",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "managementGroup_resourceDefinitions": {
    "groupQuotas": {
      "description": "Microsoft.Quota/groupQuotas",
      "properties": {
        "apiVersion": {
          "enum": [
            "2026-09-01-preview"
          ],
          "type": "string"
        },
        "name": {
          "description": "The GroupQuota name. The name should be unique for the provided context tenantId/MgId.",
          "oneOf": [
            {
              "maxLength": 63,
              "minLength": 3,
              "pattern": "^[a-z][a-z0-9]*$",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "properties": {
          "description": "Properties",
          "oneOf": [
            {
              "$ref": "#/definitions/GroupQuotasEntityProperties"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "resources": {
          "items": {
            "oneOf": [
              {
                "$ref": "#/definitions/groupQuotas_subscriptions_childResource"
              }
            ]
          },
          "type": "array"
        },
        "type": {
          "enum": [
            "Microsoft.Quota/groupQuotas"
          ],
          "type": "string"
        }
      },
      "required": [
        "name",
        "properties",
        "apiVersion",
        "type"
      ],
      "type": "object"
    },
    "groupQuotas_resourceProviders_locationSettings": {
      "description": "Microsoft.Quota/groupQuotas/resourceProviders/locationSettings",
      "properties": {
        "apiVersion": {
          "enum": [
            "2026-09-01-preview"
          ],
          "type": "string"
        },
        "name": {
          "description": "The name of the Azure region.",
          "minLength": 1,
          "type": "string"
        },
        "properties": {
          "description": "",
          "oneOf": [
            {
              "$ref": "#/definitions/GroupQuotasEnforcementStatusProperties"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "type": {
          "enum": [
            "Microsoft.Quota/groupQuotas/resourceProviders/locationSettings"
          ],
          "type": "string"
        }
      },
      "required": [
        "name",
        "properties",
        "apiVersion",
        "type"
      ],
      "type": "object"
    },
    "groupQuotas_subscriptions": {
      "description": "Microsoft.Quota/groupQuotas/subscriptions",
      "properties": {
        "apiVersion": {
          "enum": [
            "2026-09-01-preview"
          ],
          "type": "string"
        },
        "name": {
          "description": "The ID of the target subscription. The value must be an UUID.",
          "oneOf": [
            {
              "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "type": {
          "enum": [
            "Microsoft.Quota/groupQuotas/subscriptions"
          ],
          "type": "string"
        }
      },
      "required": [
        "name",
        "apiVersion",
        "type"
      ],
      "type": "object"
    }
  },
  "extension_resourceDefinitions": {
    "quotaTransfers": {
      "description": "Microsoft.Quota/quotaTransfers",
      "properties": {
        "apiVersion": {
          "enum": [
            "2026-09-01-preview"
          ],
          "type": "string"
        },
        "name": {
          "description": "The donor-chosen name segment of the quota transfer. Used as the idempotency key\nfor retries on the donor side.",
          "oneOf": [
            {
              "maxLength": 63,
              "minLength": 3,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,62}$",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "properties": {
          "description": "Properties of the quota transfer.",
          "oneOf": [
            {
              "$ref": "#/definitions/QuotaTransferProperties"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "type": {
          "enum": [
            "Microsoft.Quota/quotaTransfers"
          ],
          "type": "string"
        }
      },
      "required": [
        "name",
        "properties",
        "apiVersion",
        "type"
      ],
      "type": "object"
    }
  },
  "unknown_resourceDefinitions": {
    "quotas": {
      "description": "Microsoft.Quota/quotas",
      "properties": {
        "apiVersion": {
          "enum": [
            "2026-09-01-preview"
          ],
          "type": "string"
        },
        "name": {
          "description": "Resource name for a given resource provider. For example:\n- SKU name for Microsoft.Compute\n- SKU or TotalLowPriorityCores for Microsoft.MachineLearningServices\n For Microsoft.Network PublicIPAddresses.",
          "type": "string"
        },
        "properties": {
          "description": "Quota properties for the specified resource, based on the API called, Quotas or Usages.",
          "oneOf": [
            {
              "$ref": "#/definitions/QuotaProperties"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "type": {
          "enum": [
            "Microsoft.Quota/quotas"
          ],
          "type": "string"
        }
      },
      "required": [
        "name",
        "properties",
        "apiVersion",
        "type"
      ],
      "type": "object"
    }
  },
  "definitions": {
    "GroupQuotasEnforcementStatusProperties": {
      "properties": {
        "enforcementEnabled": {
          "description": "Is the GroupQuota Enforcement enabled for the Azure region.",
          "oneOf": [
            {
              "enum": [
                "Enabled",
                "Disabled",
                "NotAvailable"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    },
    "GroupQuotasEntityProperties": {
      "description": "Properties",
      "properties": {
        "displayName": {
          "description": "Display name of the GroupQuota entity.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "LimitJsonObject": {
      "description": "LimitJson abstract class.",
      "oneOf": [
        {
          "description": "The resource quota limit value.",
          "properties": {
            "limitType": {
              "description": "The quota or usages limit types.",
              "oneOf": [
                {
                  "enum": [
                    "Independent",
                    "Shared"
                  ],
                  "type": "string"
                },
                {
                  "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
                }
              ]
            },
            "value": {
              "description": "The quota/limit value",
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
                }
              ]
            }
          },
          "required": [
            "value"
          ],
          "type": "object"
        }
      ],
      "properties": {},
      "type": "object"
    },
    "QuotaProperties": {
      "description": "Quota properties for the specified resource.",
      "properties": {
        "limit": {
          "description": "Resource quota limit properties.",
          "oneOf": [
            {
              "$ref": "#/definitions/LimitJsonObject"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "name": {
          "description": "Resource name provided by the resource provider. Use this property name when requesting quota.",
          "oneOf": [
            {
              "$ref": "#/definitions/ResourceName"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "properties": {
          "description": "Additional properties for the specific resource provider."
        },
        "resourceType": {
          "description": "The name of the resource type. Optional field.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "QuotaTransferProperties": {
      "description": "Donor-side properties of a quota transfer.",
      "properties": {
        "amount": {
          "description": "Amount to transfer in the resource's native unit (e.g. vCPU count).",
          "oneOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "autoApprove": {
          "description": "Same-tenant one-shot opt-in. When true, the donor PUT admission-checks recipient-side\nRBAC and cap at submit time and drives the transfer to terminal Completed within the\nsame LRO, with no recipient approve required. The outcome is reflected by\n`transferStatus`: `Completed` means the auto path committed; `Pending` means it did\nnot (e.g. cross-tenant, missing RBAC, cap exceeded) and the recipient must approve.",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "billingAccountId": {
          "description": "Billing account id both donor and recipient subscriptions must roll up to.",
          "type": "string"
        },
        "comment": {
          "description": "Donor-supplied free-text rationale captured at submit time.",
          "maxLength": 500,
          "type": "string"
        },
        "destinationSubscriptionId": {
          "description": "Recipient subscription id. Must differ from the donor subscription.",
          "type": "string"
        },
        "displayName": {
          "description": "Human-friendly label surfaced on customer GET responses and recipient inbox listings.",
          "maxLength": 80,
          "type": "string"
        },
        "resourceName": {
          "description": "The quota dimension being moved, scoped by the URI's target provider\n(for example, `standardDv5Family` under Microsoft.Compute).",
          "type": "string"
        }
      },
      "required": [
        "displayName",
        "destinationSubscriptionId",
        "billingAccountId",
        "resourceName",
        "amount"
      ],
      "type": "object"
    },
    "ResourceName": {
      "description": "Name of the resource provided by the resource Provider. When requesting quota, use this property name.",
      "properties": {
        "value": {
          "description": "Resource name.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "groupQuotas_subscriptions_childResource": {
      "description": "Microsoft.Quota/groupQuotas/subscriptions",
      "properties": {
        "apiVersion": {
          "enum": [
            "2026-09-01-preview"
          ],
          "type": "string"
        },
        "name": {
          "description": "The ID of the target subscription. The value must be an UUID.",
          "oneOf": [
            {
              "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "type": {
          "enum": [
            "subscriptions"
          ],
          "type": "string"
        }
      },
      "required": [
        "name",
        "apiVersion",
        "type"
      ],
      "type": "object"
    }
  }
}