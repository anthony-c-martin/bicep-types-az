        }
      },
      "type": "object"
    },
    "SystemService": {
      "properties": {
        "publicIpAddress": {
          "description": "The public IP address of the system service",
          "type": "string"
        },
        "systemServiceType": {
          "description": "The system service type",
          "oneOf": [
            {
              "enum": [
                "None",
                "ScoringFrontEnd",
                "BatchFrontEnd"
