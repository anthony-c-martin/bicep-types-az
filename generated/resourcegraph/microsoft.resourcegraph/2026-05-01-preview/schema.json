  "definitions": {
    "EdgeTypeRef": {
      "description": "An edge-type reference declared on an ontology.",
      "properties": {
        "relationshipType": {
          "description": "The fully qualified relationship type that connects the source and target node types.\nIts own provider namespace identifies the publisher.",
          "oneOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9.]+/[A-Za-z0-9._/-]+$",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "sourceNodeType": {
          "description": "The source node's Azure resource type or its ontology-local alias.",
          "type": "string"
        },
        "targetNodeType": {
          "description": "The target node's Azure resource type or its ontology-local alias.",
          "type": "string"
        }
      },
      "required": [
        "relationshipType",
        "sourceNodeType",
        "targetNodeType"
      ],
      "type": "object"
    },
    "NodeTypeRef": {
      "description": "A node-type reference declared on an ontology.",
      "properties": {
        "alias": {
          "description": "An optional partner-facing alias for the node type.",
          "type": "string"
        },
        "resourceType": {
          "description": "The fully qualified Azure resource type, for example `microsoft.compute/virtualmachines`.",
          "oneOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9.]+/[A-Za-z0-9._/-]+$",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "required": [
        "resourceType"
      ],
      "type": "object"
    },
    "OfferingProperties": {
      "description": "The properties of an offering, the global product boundary that owns both the demand\n(ontologies, query endpoints) and the supply (data onboardings).",
      "properties": {
        "contactEmails": {
          "description": "Contact email addresses for the team that owns the offering.",
          "oneOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "displayName": {
          "description": "The partner-facing display name of the offering.",
          "type": "string"
        },
        "documentationLink": {
          "description": "A link to the offering's partner-facing documentation.",
          "type": "string"
        },
        "lifecycleState": {
          "description": "The public lifecycle state of the offering.",
          "oneOf": [
            {
              "enum": [
                "Preview",
                "GA",
                "Deprecated"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "organizationName": {
          "description": "The name of the organization that owns the offering.",
          "type": "string"
        },
        "scenarioDescription": {
          "description": "A description of the scenario the offering serves.",
          "type": "string"
        },
        "serviceTreeId": {
          "description": "The Service Tree identifier of the owning service.",
          "type": "string"
        },
        "tier": {
          "description": "The commercial tier of the offering.",
          "oneOf": [
            {
              "enum": [
                "Shared",
                "Dedicated"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "required": [
        "organizationName",
        "contactEmails",
        "scenarioDescription"
      ],
      "type": "object"
    },
    "OntologyProperties": {
      "description": "The properties of an ontology, the data-model blueprint that declares the node and edge types a\npartner needs.",
      "properties": {
        "autoOnboard": {
          "description": "When `true`, creating or updating the ontology immediately materializes global data\nonboardings for every unmet type. When `false`, gap analysis still runs and\n`validationDetails` reports the gaps, but no new supply is created. Existing approved supply\ncan still satisfy the ontology; unmet demand keeps its derived `reviewStatus` at `Submitted`.",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "displayName": {
          "description": "The partner-facing display name of the ontology.",
          "type": "string"
        },
        "edgeTypeRefs": {
          "description": "The edge types the ontology declares.",
          "oneOf": [
            {
              "items": {
                "$ref": "#/definitions/EdgeTypeRef"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "nodeTypeRefs": {
          "description": "The node types the ontology declares.",
          "oneOf": [
            {
              "items": {
                "$ref": "#/definitions/NodeTypeRef"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    },
    "OntologySnapshot": {
      "description": "A point-in-time snapshot of an ontology's semantic body that a regional activation was\ngenerated from. Only semantic fields are captured; read-only and cosmetic fields are excluded.",
      "properties": {
        "edgeTypeRefs": {
          "description": "The edge types declared by the ontology at snapshot time.",
          "oneOf": [
            {
              "items": {
                "$ref": "#/definitions/EdgeTypeRef"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "nodeTypeRefs": {
          "description": "The node types declared by the ontology at snapshot time.",
          "oneOf": [
            {
              "items": {
                "$ref": "#/definitions/NodeTypeRef"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    },
    "QueryEndpointActivationProperties": {
      "description": "The properties of a per-region query endpoint activation.",
      "properties": {},
      "type": "object"
    },
    "QueryEndpointProperties": {
      "description": "The properties of a query endpoint, a consumer activation request that references an approved\nontology within the same offering.",
      "properties": {
        "displayName": {
          "description": "The partner-facing display name of the query endpoint.",
          "minLength": 1,
          "type": "string"
        },
        "enginePreference": {
          "description": "The preferred query backend. Omission records no preference and does not provision a backend.",
          "oneOf": [
            {
              "enum": [
                "Galaxy",
                "Kusto",
                "Pacific",
                "NoPreference"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "estimatedQueriesPerDay": {
          "description": "The expected daily query volume, used for capacity planning.",
          "oneOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "ontologyRef": {
          "description": "The full Azure resource identifier of an approved ontology in the same subscription and\noffering. The reference cannot be changed after creation. Legacy bare ontology names are\naccepted on input and normalized; responses always contain the full resource identifier.",
          "type": "string"
        },
        "peakQueriesPerMinute": {
          "description": "The expected peak query rate, in queries per minute.",
          "oneOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "required": [
        "displayName",
        "ontologyRef",
        "estimatedQueriesPerDay"
      ],
      "type": "object"
    },
    "RegionalActivationProperties": {
      "description": "The properties of a per-region activation. The same body is returned whether the activation\nhangs off an ontology or off a data onboarding; the fields that do not apply to a given parent\nare simply empty. `assignments` is populated only for a data-onboarding activation, and\n`materializedDataOnboardingRefs` only for an ontology activation.",
      "properties": {
        "ontologySnapshot": {
          "description": "The snapshot of the ontology body this activation was generated from. When supplied on create\nor update, Azure Resource Graph compares it against the currently approved global ontology and\nrejects the activation if they differ, enforcing the one-active-rollout invariant. When\nomitted, the drift check is skipped. It is persisted and returned on read.",
          "oneOf": [
            {
              "$ref": "#/definitions/OntologySnapshot"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    },
