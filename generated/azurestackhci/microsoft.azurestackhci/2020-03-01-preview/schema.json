{
  "id": "https://schema.management.azure.com/schemas/2020-03-01-preview/Microsoft.AzureStackHCI.json#",
  "title": "Microsoft.AzureStackHCI",
  "description": "Microsoft AzureStackHCI Resource Types",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "resourceDefinitions": {
    "clusters": {
      "description": "Microsoft.AzureStackHCI/clusters",
      "properties": {
        "apiVersion": {
          "enum": [
            "2020-03-01-preview"
          ],
          "type": "string"
        },
        "id": {
          "description": "Fully qualified resource ID for the resource. Ex - /subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/{resourceProviderNamespace}/{resourceType}/{resourceName}",
          "type": "string"
        },
        "location": {
          "description": "The geo-location where the resource lives",
          "type": "string"
        },
        "name": {
          "description": "The name of the cluster.",
          "type": "string"
        },
        "properties": {
          "description": "Cluster properties.",
          "oneOf": [
            {
              "$ref": "#/definitions/ClusterProperties"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "tags": {
          "description": "Resource tags.",
          "oneOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "properties": {},
              "type": "object"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "type": {
          "enum": [
            "Microsoft.AzureStackHCI/clusters"
          ],
          "type": "string"
        }
      },
      "required": [
        "name",
        "apiVersion",
        "type"
      ],
      "type": "object"
    }
  },
  "definitions": {
    "ClusterNode": {
      "properties": {
        "coreCount": {
          "description": "Number of physical cores on the cluster node.",
          "oneOf": [
            {
              "type": "number"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "id": {
          "description": "Id of the node in the cluster.",
          "oneOf": [
            {
              "type": "number"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "manufacturer": {
          "description": "Manufacturer of the cluster node hardware.",
          "type": "string"
        },
        "memoryInGiB": {
          "description": "Total available memory on the cluster node (in GiB).",
          "oneOf": [
            {
              "type": "number"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "model": {
          "description": "Model name of the cluster node hardware.",
          "type": "string"
        },
        "name": {
          "description": "Name of the cluster node.",
          "type": "string"
        },
        "osName": {
          "description": "Operating system running on the cluster node.",
          "type": "string"
        },
        "osVersion": {
          "description": "Version of the operating system running on the cluster node.",
          "type": "string"
        },
        "serialNumber": {
          "description": "Immutable id of the cluster node.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "ClusterProperties": {
      "properties": {
        "aadClientId": {
          "description": "App id of cluster AAD identity.",
          "type": "string"
        },
        "aadTenantId": {
          "description": "Tenant id of cluster AAD identity.",
          "type": "string"
        },
        "billingModel": {
          "description": "Type of billing applied to the resource.",
          "type": "string"
        },
        "cloudId": {
          "description": "Unique, immutable resource id.",
          "type": "string"
        },
        "lastBillingTimestamp": {
          "description": "Most recent billing meter timestamp.",
          "oneOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "lastSyncTimestamp": {
          "description": "Most recent cluster sync timestamp.",
          "oneOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "provisioningState": {
          "description": "Provisioning state.",
          "oneOf": [
            {
              "enum": [
                "Succeeded",
                "Failed",
                "Canceled",
                "Accepted",
                "Provisioning"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "registrationTimestamp": {
          "description": "First cluster sync timestamp.",
          "oneOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "reportedProperties": {
          "description": "Properties reported by cluster agent.",
          "oneOf": [
            {
              "$ref": "#/definitions/ClusterReportedProperties"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "status": {
          "description": "Status of the cluster agent.",
          "oneOf": [
            {
              "enum": [
                "NotYetRegistered",
                "ConnectedRecently",
                "NotConnectedRecently",
                "Disconnected",
                "Error"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "trialDaysRemaining": {
          "description": "Number of days remaining in the trial period.",
          "oneOf": [
            {
              "type": "number"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "required": [
        "aadClientId",
        "aadTenantId"
      ],
      "type": "object"
    },
    "ClusterReportedProperties": {
      "properties": {
        "clusterId": {
          "description": "Unique id generated by the on-prem cluster.",
          "type": "string"
        },
        "clusterName": {
          "description": "Name of the on-prem cluster connected to this resource.",
          "type": "string"
        },
        "clusterVersion": {
          "description": "Version of the cluster software.",
          "type": "string"
        },
        "lastUpdated": {
          "description": "Last time the cluster reported the data.",
          "oneOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "nodes": {
          "description": "List of nodes reported by the cluster.",
          "oneOf": [
            {
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/definitions/ClusterNode"
                  },
                  {
                    "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
                  }
                ]
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    }
  }
}