              "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "status": {
          "description": "The status of the sql pool.",
          "oneOf": [
            {
              "enum": [
                "Invisible",
                "Online",
                "Offline",
                "Creating",
                "Inaccessible",
                "Pausing",
                "Paused",
                "Resuming",
                "Scaling",
                "Dropping",
                "Error",
                "Unknown"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
