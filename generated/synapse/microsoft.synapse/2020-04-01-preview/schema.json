            {
              "type": "integer"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "autoResume": {
          "description": "Indicates whether the sql pool can automatically resume when connection attempts are made.",
