          "type": "string"
        },
        "maxServiceObjectiveName": {
          "description": "The max service level objective name of the sql pool.",
          "type": "string"
        },
        "requestedServiceObjectiveName": {
          "description": "The requested service level objective name of the sql pool.",
          "type": "string"
