{
  "id": "https://schema.management.azure.com/schemas/2019-09-01-preview/Microsoft.Media.json#",
  "title": "Microsoft.Media",
  "description": "Microsoft Media Resource Types",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "resourceDefinitions": {
    "mediaServices_mediaGraphs": {
      "description": "Microsoft.Media/mediaServices/mediaGraphs",
      "properties": {
        "apiVersion": {
          "enum": [
            "2019-09-01-preview"
          ],
          "type": "string"
        },
        "id": {
          "description": "Fully qualified resource ID for the resource.",
          "type": "string"
        },
        "name": {
          "description": "The Media Graph name.",
          "type": "string"
        },
        "properties": {
          "description": "Class for Media Graph properties",
          "oneOf": [
            {
              "$ref": "#/definitions/MediaGraphProperties"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "type": {
          "enum": [
            "Microsoft.Media/mediaServices/mediaGraphs"
          ],
          "type": "string"
        }
      },
      "required": [
        "name",
        "apiVersion",
        "type"
      ],
      "type": "object"
    }
  },
  "definitions": {
    "MediaGraphProperties": {
      "properties": {
        "created": {
          "description": "Date the Media Graph was created",
          "oneOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "description": {
          "description": "Media Graph  description",
          "type": "string"
        },
        "lastModified": {
          "description": "Date the Media Graph was last modified",
          "oneOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "sinks": {
          "description": "Media Graph sinks",
          "oneOf": [
            {
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/definitions/MediaGraphSink"
                  },
                  {
                    "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
                  }
                ]
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "sources": {
          "description": "Media Graph sources",
          "oneOf": [
            {
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/definitions/MediaGraphSource"
                  },
                  {
                    "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
                  }
                ]
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "state": {
          "description": "Media Graph state",
          "oneOf": [
            {
              "enum": [
                "Running",
                "Starting",
                "Stopped",
                "Stopping"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "required": [
        "sources",
        "sinks"
      ],
      "type": "object"
    },
    "MediaGraphSink": {
      "properties": {
        "inputs": {
          "description": "Sink inputs",
          "oneOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "name": {
          "description": "Sink name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "inputs"
      ],
      "type": "object"
    },
    "MediaGraphSource": {
      "properties": {
        "name": {
          "description": "Source name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "MediaGraphUserCredentials": {
      "properties": {
        "password": {
          "description": "Password credential",
          "type": "string"
        },
        "username": {
          "description": "User name",
          "type": "string"
        }
      },
      "required": [
        "username",
        "password"
      ],
      "type": "object"
    }
  }
}