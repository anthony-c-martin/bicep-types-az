{
  "id": "https://schema.management.azure.com/schemas/2019-04-01/Microsoft.VMwareCloudSimple.json#",
  "title": "Microsoft.VMwareCloudSimple",
  "description": "Microsoft VMwareCloudSimple Resource Types",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "resourceDefinitions": {
    "dedicatedCloudServices": {
      "description": "Microsoft.VMwareCloudSimple/dedicatedCloudServices",
      "properties": {
        "apiVersion": {
          "enum": [
            "2019-04-01"
          ],
          "type": "string"
        },
        "id": {
          "description": "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/{resourceProviderNamespace}/dedicatedCloudServices/{dedicatedCloudServiceName}",
          "type": "string"
        },
        "location": {
          "description": "Azure region",
          "type": "string"
        },
        "name": {
          "description": "dedicated cloud Service name",
          "oneOf": [
            {
              "pattern": "^[a-zA-Z0-9]([-_.a-zA-Z0-9]*[a-zA-Z0-9])?$",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "properties": {
          "description": "The properties of Dedicated Node Service",
          "oneOf": [
            {
              "$ref": "#/definitions/DedicatedCloudServiceProperties"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "tags": {
          "description": "The list of tags",
          "oneOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "properties": {},
              "type": "object"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "type": {
          "enum": [
            "Microsoft.VMwareCloudSimple/dedicatedCloudServices"
          ],
          "type": "string"
        }
      },
      "required": [
        "name",
        "apiVersion",
        "type"
      ],
      "type": "object"
    }
  },
  "definitions": {
    "DedicatedCloudServiceProperties": {
      "properties": {
        "gatewaySubnet": {
          "description": "gateway Subnet for the account. It will collect the subnet address and always treat it as /28",
          "type": "string"
        },
        "isAccountOnboarded": {
          "description": "indicates whether account onboarded or not in a given region",
          "oneOf": [
            {
              "enum": [
                "notOnBoarded",
                "onBoarded",
                "onBoardingFailed",
                "onBoarding"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "nodes": {
          "description": "total nodes purchased",
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "serviceURL": {
          "description": "link to a service management web portal",
          "type": "string"
        }
      },
      "required": [
        "gatewaySubnet"
      ],
      "type": "object"
    }
  }
}