              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "leavingNodeCount": {
          "description": "Number of compute nodes which are leaving the amlCompute.",
          "oneOf": [
            {
              "type": "integer"
            },
