{
  "id": "https://schema.management.azure.com/schemas/2022-11-16-preview/Microsoft.AppComplianceAutomation.json#",
  "title": "Microsoft.AppComplianceAutomation",
  "description": "Microsoft AppComplianceAutomation Resource Types",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "tenant_resourceDefinitions": {
    "reports": {
      "description": "Microsoft.AppComplianceAutomation/reports",
      "properties": {
        "apiVersion": {
          "enum": [
            "2022-11-16-preview"
          ],
          "type": "string"
        },
        "id": {
          "description": "Fully qualified resource ID for the resource. Ex - /subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/{resourceProviderNamespace}/{resourceType}/{resourceName}",
          "type": "string"
        },
        "name": {
          "description": "Report Name.",
          "oneOf": [
            {
              "pattern": "^[-a-zA-Z0-9_]+$",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "properties": {
          "description": "Report property.",
          "oneOf": [
            {
              "$ref": "#/definitions/ReportProperties"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "systemData": {
          "description": "Azure Resource Manager metadata containing createdBy and modifiedBy information.",
          "oneOf": [
            {
              "$ref": "#/definitions/SystemData"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "type": {
          "enum": [
            "Microsoft.AppComplianceAutomation/reports"
          ],
          "type": "string"
        }
      },
      "required": [
        "name",
        "apiVersion",
        "type"
      ],
      "type": "object"
    }
  },
  "definitions": {
    "OverviewStatus": {
      "properties": {
        "failedCount": {
          "description": "The count of all failed full automation control.",
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "manualCount": {
          "description": "The count of all manual control.",
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "passedCount": {
          "description": "The count of all passed full automation control.",
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    },
    "ReportComplianceStatus": {
      "properties": {
        "m365": {
          "description": "The Microsoft 365 certification name.",
          "oneOf": [
            {
              "$ref": "#/definitions/OverviewStatus"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    },
    "ReportProperties": {
      "properties": {
        "complianceStatus": {
          "description": "Report compliance status.",
          "oneOf": [
            {
              "$ref": "#/definitions/ReportComplianceStatus"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "id": {
          "description": "Report id in database.",
          "type": "string"
        },
        "lastTriggerTime": {
          "description": "Report last collection trigger time.",
          "oneOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "nextTriggerTime": {
          "description": "Report next collection trigger time.",
          "oneOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "offerGuid": {
          "description": "Report offer Guid.",
          "type": "string"
        },
        "provisioningState": {
          "description": "Azure lifecycle management",
          "oneOf": [
            {
              "enum": [
                "Succeeded",
                "Failed",
                "Canceled",
                "Creating",
                "Deleting",
                "Updating"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "reportName": {
          "description": "Report name.",
          "type": "string"
        },
        "resources": {
          "description": "List of resource data.",
          "oneOf": [
            {
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/definitions/ResourceMetadata"
                  },
                  {
                    "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
                  }
                ]
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "status": {
          "description": "Report status.",
          "oneOf": [
            {
              "enum": [
                "Active",
                "Failed",
                "Disabled"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "subscriptions": {
          "description": "List of subscription Ids.",
          "oneOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "tenantId": {
          "description": "Report's tenant id.",
          "type": "string"
        },
        "timeZone": {
          "description": "Report collection trigger time's time zone, the available list can be obtained by executing \"Get-TimeZone -ListAvailable\" in PowerShell.\r\nAn example of valid timezone id is \"Pacific Standard Time\".",
          "type": "string"
        },
        "triggerTime": {
          "description": "Report collection trigger time.",
          "oneOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "required": [
        "timeZone",
        "triggerTime",
        "resources"
      ],
      "type": "object"
    },
    "ResourceMetadata": {
      "properties": {
        "resourceId": {
          "description": "Resource Id - e.g. \"/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg1/providers/Microsoft.Compute/virtualMachines/vm1\".",
          "type": "string"
        },
        "resourceKind": {
          "description": "Resource kind.",
          "type": "string"
        },
        "resourceName": {
          "description": "Resource name.",
          "type": "string"
        },
        "resourceType": {
          "description": "Resource type.",
          "type": "string"
        },
        "tags": {
          "description": "Resource's tag type.",
          "oneOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "properties": {},
              "type": "object"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "required": [
        "resourceId"
      ],
      "type": "object"
    },
    "SystemData": {
      "properties": {
        "createdAt": {
          "description": "The timestamp of resource creation (UTC).",
          "oneOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "createdBy": {
          "description": "The identity that created the resource.",
          "type": "string"
        },
        "createdByType": {
          "description": "The type of identity that created the resource.",
          "oneOf": [
            {
              "enum": [
                "User",
                "Application",
                "ManagedIdentity",
                "Key"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "lastModifiedAt": {
          "description": "The timestamp of resource last modification (UTC)",
          "oneOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "lastModifiedBy": {
          "description": "The identity that last modified the resource.",
          "type": "string"
        },
        "lastModifiedByType": {
          "description": "The type of identity that last modified the resource.",
          "oneOf": [
            {
              "enum": [
                "User",
                "Application",
                "ManagedIdentity",
                "Key"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    }
  }
}