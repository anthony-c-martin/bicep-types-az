        "alternateEmail": {
          "description": "Alternate Email address",
          "type": "string"
        },
        "contactPhoneNumber": {
          "description": "Contact phone number",
          "type": "string"
        },
        "email": {
          "description": "User Email",
          "type": "string"
        },
        "firstName": {
          "description": "First name",
          "type": "string"
        },
        "lastName": {
          "description": "Last name",
          "type": "string"
        },
        "upn": {
          "description": "UPN of user",
          "type": "string"
        }
