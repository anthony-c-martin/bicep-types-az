        "provisioningState": {
          "description": "Current provisioning status of the database",
          "oneOf": [
            {
              "enum": [
                "Succeeded",
                "Failed",
                "Canceled",
                "Creating",
                "Updating",
                "Deleting"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "resourceState": {
          "description": "Current resource status of the database",
          "oneOf": [
            {
              "enum": [
                "Running",
                "Creating",
                "CreateFailed",
                "Updating",
                "UpdateFailed",
                "Deleting",
                "DeleteFailed",
                "Enabling",
                "EnableFailed",
                "Disabling",
                "DisableFailed",
                "Disabled"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
