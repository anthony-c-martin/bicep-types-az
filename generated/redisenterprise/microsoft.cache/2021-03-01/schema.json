              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "redisVersion": {
          "description": "Version of redis the cluster supports, e.g. '6'",
          "type": "string"
        },
        "resourceState": {
          "description": "Current resource status of the cluster",
          "oneOf": [
            {
              "enum": [
                "Running",
                "Creating",
                "CreateFailed",
                "Updating",
                "UpdateFailed",
                "Deleting",
                "DeleteFailed",
                "Enabling",
                "EnableFailed",
                "Disabling",
                "DisableFailed",
                "Disabled"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
