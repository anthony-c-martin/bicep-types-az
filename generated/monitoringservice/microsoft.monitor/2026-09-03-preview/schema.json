  "definitions": {
    "AzureMonitorWorkspace": {
      "description": "Properties of an Azure Monitor Workspace",
      "properties": {
        "actions": {
          "description": "Action configuration for the Azure Monitor Workspace.",
          "oneOf": [
            {
              "$ref": "#/definitions/AzureMonitorWorkspaceActions"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "metrics": {
          "description": "Properties related to the metrics container in the Azure Monitor Workspace",
          "oneOf": [
            {
              "$ref": "#/definitions/AzureMonitorWorkspaceMetrics"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "publicNetworkAccess": {
          "description": "Gets or sets allow or disallow public network access to Azure Monitor Workspace",
          "oneOf": [
            {
              "enum": [
                "Enabled",
                "Disabled"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    },
    "AzureMonitorWorkspaceActions": {
      "description": "Action configuration for an Azure Monitor Workspace.",
      "properties": {
        "defaultActionGroups": {
          "description": "The default action groups associated with the Azure Monitor Workspace.",
          "oneOf": [
            {
              "items": {
                "$ref": "#/definitions/DefaultActionGroupResource"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    },
    "AzureMonitorWorkspaceMetrics": {
      "description": "Properties related to the metrics container in the Azure Monitor Workspace",
      "properties": {
        "enableAccessUsingResourcePermissions": {
          "description": "Flag that indicates whether to enable access using resource permissions.",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    },
    "Background": {
      "description": "The issue background information",
      "properties": {
        "details": {
          "description": "The background details",
          "oneOf": [
            {
              "items": {
                "$ref": "#/definitions/BackgroundDetails"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "text": {
          "description": "The background text",
          "type": "string"
        },
        "type": {
          "description": "The background type",
          "type": "string"
        }
      },
      "type": "object"
    },
    "BackgroundDetails": {
      "description": "A background details element",
      "properties": {
        "name": {
          "description": "The background details name",
          "type": "string"
        },
        "value": {
          "description": "The background details value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "type": "object"
    },
    "DefaultActionGroupResource": {
      "description": "A reference to an Azure Monitor action group.",
      "properties": {
        "id": {
          "description": "The resource ID of the action group.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "IssueNotificationType": {
      "description": "Base properties for an issue notification type",
      "oneOf": [
        {
          "description": "Notification type for issue creation events",
          "properties": {},
          "type": "object"
        },
        {
          "description": "Notification type for on-change events",
          "properties": {},
          "type": "object"
        },
        {
          "description": "Notification type for time-based updates",
          "properties": {
            "updateInterval": {
              "description": "The interval between time-based updates",
              "type": "string"
            }
          },
          "required": [
            "updateInterval"
          ],
          "type": "object"
        }
      ],
      "properties": {},
      "type": "object"
    },
    "IssueProperties": {
      "description": "The issue properties",
      "properties": {
        "background": {
          "description": "The issue background information",
          "oneOf": [
            {
              "$ref": "#/definitions/Background"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "impactTime": {
          "description": "The issue impact time (in UTC)",
          "format": "date-time",
          "type": "string"
        },
        "notifications": {
          "description": "The issue notification settings",
          "oneOf": [
            {
              "$ref": "#/definitions/Notifications"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "severity": {
          "description": "The issue severity",
          "type": "string"
        },
        "status": {
          "description": "The issue status",
          "oneOf": [
            {
              "enum": [
                "New",
                "InProgress",
                "Mitigated",
                "Closed",
                "Canceled"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "title": {
          "description": "The issue title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "status",
        "severity",
        "impactTime"
      ],
      "type": "object"
    },
    "ManagedServiceIdentity": {
      "description": "Managed service identity (system assigned and/or user assigned identities)",
      "properties": {
        "type": {
          "description": "Type of managed service identity (where both SystemAssigned and UserAssigned types are allowed).",
          "oneOf": [
            {
              "enum": [
                "None",
                "SystemAssigned",
                "UserAssigned",
                "SystemAssigned,UserAssigned"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "userAssignedIdentities": {
          "description": "The set of user assigned identities associated with the resource. The userAssignedIdentities dictionary keys will be ARM resource ids in the form: '/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.ManagedIdentity/userAssignedIdentities/{identityName}. The dictionary values can be empty objects ({}) in requests.",
          "oneOf": [
            {
              "additionalProperties": {
                "$ref": "#/definitions/UserAssignedIdentity"
              },
              "properties": {},
              "type": "object"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "MetricAggregationConfiguration": {
      "description": "An aggregation configuration for an aggregated metric.",
      "properties": {
        "aggregationFunctions": {
          "description": "Aggregation functions enabled for this aggregation.",
          "oneOf": [
            {
              "$ref": "#/definitions/MetricAggregationFunctions"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "dimensions": {
          "description": "Dimensions included in this aggregation.",
          "oneOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "storeAggregatedData": {
          "description": "Whether aggregated metric data is stored.",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    },
    "MetricAggregationFunctions": {
      "description": "Aggregation functions enabled for an aggregated metric.",
      "properties": {
        "enableMinMax": {
          "description": "Whether minimum and maximum aggregations are enabled.",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "enablePercentiles": {
          "description": "Whether percentile aggregations are enabled.",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "required": [
        "enableMinMax",
        "enablePercentiles"
      ],
      "type": "object"
    },
    "MetricConfigurationProperties": {
      "description": "Properties of a metric configuration.",
      "properties": {
        "aggregationConfigurations": {
          "description": "Aggregation configurations for an aggregated metric.",
          "oneOf": [
            {
              "items": {
                "$ref": "#/definitions/MetricAggregationConfiguration"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "metricName": {
          "description": "The actual ingested metric name before route encoding.",
          "type": "string"
        },
        "metricType": {
          "description": "The metric type.",
          "oneOf": [
            {
              "enum": [
                "Raw",
                "Aggregated"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "namespace": {
          "description": "The actual metric namespace before route encoding.",
          "type": "string"
        },
        "sourceMetricResourceId": {
          "description": "The resource ID of the source metric for an aggregated metric.",
          "type": "string"
        },
        "storeRawData": {
          "description": "Whether raw metric data is stored.",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    },
    "MetricsContainer": {
      "description": "Properties of a metrics container.",
      "properties": {
        "limits": {
          "description": "Metrics limits.",
          "oneOf": [
            {
              "$ref": "#/definitions/MetricsLimits"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "version": {
          "description": "The version of Metrics Query Service that this AMW will use for all metric queries.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "MetricsLimits": {
      "description": "Definition of Metrics limits",
      "properties": {
        "enableAutoScale": {
          "description": "Indicates whether automatic scaling of ingestion limits is enabled.",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "maxActiveTimeSeries": {
          "description": "Maximum number of active time series allowed on the metrics containers.",
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "maxEventsPerMinute": {
          "description": "Maximum rate (events per minute) that can be processed on the metrics containers.",
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    },
    "Notifications": {
      "description": "Issue notification settings",
      "properties": {
        "actionGroupIds": {
          "description": "The action group IDs to notify",
          "oneOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "excludeDefaultActionGroups": {
          "description": "Whether to exclude default action groups from notifications",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "updateTypes": {
          "description": "The types of updates that trigger notifications",
          "oneOf": [
            {
              "items": {
                "$ref": "#/definitions/IssueNotificationType"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    },
    "TraceAssociation": {
      "description": "Properties of a trace association.",
      "properties": {
