        "name",
        "properties",
        "apiVersion",
        "type"
      ],
      "type": "object"
    },
    "accounts_metricsContainers": {
      "description": "Microsoft.Monitor/accounts/metricsContainers",
      "properties": {
        "apiVersion": {
          "enum": [
            "2026-09-03-preview"
          ],
          "type": "string"
        },
        "name": {
          "description": "The name of the MetricsContainer",
          "oneOf": [
            {
              "pattern": "^default$",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "properties": {
          "description": "The resource-specific properties for this resource.",
          "oneOf": [
            {
              "$ref": "#/definitions/MetricsContainer"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "type": {
          "enum": [
            "Microsoft.Monitor/accounts/metricsContainers"
          ],
          "type": "string"
        }
      },
      "required": [
        "name",
        "properties",
        "apiVersion",
        "type"
      ],
      "type": "object"
    },
    "accounts_metricsContainers_namespaces_metrics": {
      "description": "Microsoft.Monitor/accounts/metricsContainers/namespaces/metrics",
      "properties": {
        "apiVersion": {
          "enum": [
            "2026-09-03-preview"
          ],
          "type": "string"
        },
        "name": {
          "description": "Tilde encoding is used for the metric name in the URL path. It is similar to percent encoding but uses `~` instead of `%`. For example, `/` is encoded as `~2F`. The original metric name is provided in `properties.metricName`.",
          "oneOf": [
            {
              "maxLength": 260,
              "pattern": "^(?:[A-Za-z0-9._-]|~[0-9A-Fa-f]{2})+$",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "properties": {
          "description": "The resource-specific properties for this resource.",
          "oneOf": [
            {
              "$ref": "#/definitions/MetricConfigurationProperties"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "type": {
          "enum": [
            "Microsoft.Monitor/accounts/metricsContainers/namespaces/metrics"
          ],
          "type": "string"
        }
      },
      "required": [
        "name",
        "properties",
        "apiVersion",
        "type"
      ],
      "type": "object"
    },
    "accounts_traceContainers": {
      "description": "Microsoft.Monitor/accounts/traceContainers",
