{
  "id": "https://schema.management.azure.com/schemas/2017-10-01/Microsoft.PowerBIDedicated.json#",
  "title": "Microsoft.PowerBIDedicated",
  "description": "Microsoft PowerBIDedicated Resource Types",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "resourceDefinitions": {
    "capacities": {
      "description": "Microsoft.PowerBIDedicated/capacities",
      "properties": {
        "apiVersion": {
          "enum": [
            "2017-10-01"
          ],
          "type": "string"
        },
        "id": {
          "description": "An identifier that represents the PowerBI Dedicated resource.",
          "type": "string"
        },
        "location": {
          "description": "Location of the PowerBI Dedicated resource.",
          "type": "string"
        },
        "name": {
          "description": "The name of the Dedicated capacity. It must be a minimum of 3 characters, and a maximum of 63.",
          "oneOf": [
            {
              "maxLength": 63,
              "minLength": 3,
              "pattern": "^[a-z][a-z0-9]*$",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "properties": {
          "description": "Properties of the provision operation request.",
          "oneOf": [
            {
              "$ref": "#/definitions/DedicatedCapacityProperties"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "sku": {
          "description": "The SKU of the PowerBI Dedicated resource.",
          "oneOf": [
            {
              "$ref": "#/definitions/ResourceSku"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "tags": {
          "description": "Key-value pairs of additional resource provisioning properties.",
          "oneOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "properties": {},
              "type": "object"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "type": {
          "enum": [
            "Microsoft.PowerBIDedicated/capacities"
          ],
          "type": "string"
        }
      },
      "required": [
        "name",
        "apiVersion",
        "type"
      ],
      "type": "object"
    }
  },
  "definitions": {
    "DedicatedCapacityAdministrators": {
      "properties": {
        "members": {
          "description": "An array of administrator user identities.",
          "oneOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    },
    "DedicatedCapacityProperties": {
      "properties": {
        "administration": {
          "description": "A collection of Dedicated capacity administrators",
          "oneOf": [
            {
              "$ref": "#/definitions/DedicatedCapacityAdministrators"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "friendlyName": {
          "description": "Capacity name",
          "type": "string"
        },
        "mode": {
          "description": "The capacity mode.",
          "type": "string"
        },
        "provisioningState": {
          "description": "The current deployment state of PowerBI Dedicated resource. The provisioningState is to indicate states for resource provisioning.",
          "oneOf": [
            {
              "enum": [
                "Deleting",
                "Succeeded",
                "Failed",
                "Paused",
                "Suspended",
                "Provisioning",
                "Updating",
                "Suspending",
                "Pausing",
                "Resuming",
                "Preparing",
                "Scaling"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "state": {
          "description": "The current state of PowerBI Dedicated resource. The state is to indicate more states outside of resource provisioning.",
          "oneOf": [
            {
              "enum": [
                "Deleting",
                "Succeeded",
                "Failed",
                "Paused",
                "Suspended",
                "Provisioning",
                "Updating",
                "Suspending",
                "Pausing",
                "Resuming",
                "Preparing",
                "Scaling"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "tenantId": {
          "description": "Tenant ID for the capacity. Used for creating Pro Plus capacity.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "ResourceSku": {
      "properties": {
        "capacity": {
          "description": "The capacity of the SKU.",
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "name": {
          "description": "Name of the SKU level.",
          "type": "string"
        },
        "tier": {
          "description": "The name of the Azure pricing tier to which the SKU applies.",
          "oneOf": [
            {
              "enum": [
                "PBIE_Azure"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    }
  }
}