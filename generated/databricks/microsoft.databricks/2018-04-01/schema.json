            {
              "type": "boolean"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "required": [
        "value"
      ],
      "type": "object"
    },
    "WorkspaceCustomObjectParameter": {
      "properties": {
        "type": {
          "description": "The type of variable that this is",
          "oneOf": [
            {
              "enum": [
                "Bool",
                "Object",
                "String"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
