        "resources": {
          "items": {
            "oneOf": [
              {
                "$ref": "#/definitions/registries_buildTasks_steps_childResource"
              }
            ]
          },
          "type": "array"
        },
        "tags": {
          "description": "The tags of the resource.",
          "oneOf": [
            {
