{
  "id": "https://schema.management.azure.com/schemas/2017-10-01/microsoft.insights.json#",
  "title": "microsoft.insights",
  "description": "microsoft insights Resource Types",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "resourceDefinitions": {
    "components_pricingPlans": {
      "description": "microsoft.insights/components/pricingPlans",
      "properties": {
        "apiVersion": {
          "enum": [
            "2017-10-01"
          ],
          "type": "string"
        },
        "id": {
          "description": "Azure resource Id.",
          "type": "string"
        },
        "name": {
          "pattern": "^.*/current$",
          "type": "string"
        },
        "properties": {
          "description": "The properties of the suppression.",
          "oneOf": [
            {
              "$ref": "#/definitions/PricingPlanProperties"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "type": {
          "enum": [
            "microsoft.insights/components/pricingPlans"
          ],
          "type": "string"
        }
      },
      "required": [
        "name",
        "apiVersion",
        "type"
      ],
      "type": "object"
    }
  },
  "definitions": {
    "PricingPlanProperties": {
      "properties": {
        "cap": {
          "description": "Daily data volume cap in GB.",
          "oneOf": [
            {
              "type": "number"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "maxHistoryCap": {
          "description": "Maximum daily data volume cap that the user can set for this component.",
          "oneOf": [
            {
              "type": "number"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "planType": {
          "description": "Pricing Plan Type Name.",
          "type": "string"
        },
        "resetHour": {
          "description": "Daily data volume cap UTC reset hour.",
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "stopSendNotificationWhenHitCap": {
          "description": "Do not send a notification email when the daily data volume cap is met.",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "stopSendNotificationWhenHitThreshold": {
          "description": "Reserved, not used for now.",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "warningThreshold": {
          "description": "Reserved, not used for now.",
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    }
  }
}