{
  "id": "https://schema.management.azure.com/schemas/2021-06-03-preview/Microsoft.Monitor.json#",
  "title": "Microsoft.Monitor",
  "description": "Microsoft Monitor Resource Types",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "resourceDefinitions": {
    "accounts": {
      "description": "Microsoft.Monitor/accounts",
      "properties": {
        "apiVersion": {
          "enum": [
            "2021-06-03-preview"
          ],
          "type": "string"
        },
        "etag": {
          "description": "Resource entity tag (ETag)",
          "type": "string"
        },
        "id": {
          "description": "Fully qualified resource ID for the resource. Ex - /subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/{resourceProviderNamespace}/{resourceType}/{resourceName}",
          "type": "string"
        },
        "location": {
          "description": "The geo-location where the resource lives",
          "type": "string"
        },
        "name": {
          "description": "The name of the Azure Monitor workspace.  The name is case insensitive",
          "oneOf": [
            {
              "pattern": "^(?!-)[a-zA-Z0-9-]+[^-]$",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "properties": {
          "description": "Resource properties",
          "oneOf": [
            {
              "$ref": "#/definitions/AzureMonitorWorkspaceResourceProperties"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "systemData": {
          "description": "Azure Resource Manager metadata containing createdBy and modifiedBy information.",
          "oneOf": [
            {
              "$ref": "#/definitions/SystemData"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "tags": {
          "description": "Resource tags.",
          "oneOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "properties": {},
              "type": "object"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "type": {
          "enum": [
            "Microsoft.Monitor/accounts"
          ],
          "type": "string"
        }
      },
      "required": [
        "name",
        "apiVersion",
        "type"
      ],
      "type": "object"
    }
  },
  "definitions": {
    "AzureMonitorWorkspaceDefaultIngestionSettings": {
      "properties": {
        "dataCollectionEndpointResourceId": {
          "description": "The Azure resource Id of the default data collection endpoint for this workspace.",
          "type": "string"
        },
        "dataCollectionRuleResourceId": {
          "description": "The Azure resource Id of the default data collection rule for this workspace.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "AzureMonitorWorkspaceMetrics": {
      "properties": {
        "internalId": {
          "description": "An internal identifier for the metrics container. Only to be used by the system",
          "type": "string"
        },
        "prometheusQueryEndpoint": {
          "description": "The Prometheus query endpoint for the workspace",
          "type": "string"
        }
      },
      "type": "object"
    },
    "AzureMonitorWorkspaceResourceProperties": {
      "properties": {
        "accountId": {
          "description": "The immutable ID of the Azure Monitor workspace. This property is read-only.",
          "type": "string"
        },
        "defaultIngestionSettings": {
          "description": "The Data Collection Rule and Endpoint used for ingestion by default.",
          "oneOf": [
            {
              "$ref": "#/definitions/AzureMonitorWorkspaceDefaultIngestionSettings"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "metrics": {
          "description": "Information about metrics for the Azure Monitor workspace",
          "oneOf": [
            {
              "$ref": "#/definitions/AzureMonitorWorkspaceMetrics"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "provisioningState": {
          "description": "The provisioning state of the Azure Monitor workspace. Set to Succeeded if everything is healthy.",
          "oneOf": [
            {
              "enum": [
                "Creating",
                "Succeeded",
                "Deleting",
                "Failed",
                "Canceled"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    },
    "SystemData": {
      "properties": {
        "createdAt": {
          "description": "The timestamp of resource creation (UTC).",
          "oneOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "createdBy": {
          "description": "The identity that created the resource.",
          "type": "string"
        },
        "createdByType": {
          "description": "The type of identity that created the resource.",
          "oneOf": [
            {
              "enum": [
                "User",
                "Application",
                "ManagedIdentity",
                "Key"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "lastModifiedAt": {
          "description": "The timestamp of resource last modification (UTC)",
          "oneOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "lastModifiedBy": {
          "description": "The identity that last modified the resource.",
          "type": "string"
        },
        "lastModifiedByType": {
          "description": "The type of identity that last modified the resource.",
          "oneOf": [
            {
              "enum": [
                "User",
                "Application",
                "ManagedIdentity",
                "Key"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    }
  }
}