    "AddressDetails": {
      "properties": {
        "addressLine1": {
          "description": "Address line 1.",
          "type": "string"
        },
        "addressLine2": {
          "description": "Address line 2.",
          "type": "string"
        },
        "addressLine3": {
          "description": "Address line 3.",
          "type": "string"
        },
        "city": {
          "description": "Address city.",
          "type": "string"
        },
        "companyName": {
          "description": "Company name.",
